{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "2048",
  "version": "1.0.0",
  "identifier": "io.github.ghinta.game2048",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:4173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "2048",
        "width": 460,
        "height": 740,
        "minWidth": 320,
        "minHeight": 320,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "shortDescription": "2048 mit Tastatur oder Wischgesten spielen.",
    "category": "PuzzleGame"
  }
}
